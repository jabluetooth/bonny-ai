# ──────────────────────────────────────────────────────────────────────────────
# bonny-ai — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ──────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
# Find these in: Supabase dashboard → Project Settings → API

# Public URL for your Supabase project (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public anon key — used by the browser client (safe to expose)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — KEEP SECRET. Used by scripts/embed-data.ts and by the
# server-side admin client (lib/supabase-admin.ts) for the GitHub content
# agent's writes. Bypasses RLS. Never expose to the browser or commit to git.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── AI Providers ──────────────────────────────────────────────────────────────
# The LLM tries GROQ_API_KEY first, falls back to OPENAI_API_KEY.
# You must provide at least one; both can coexist.

# Groq API key — fast inference via llama-3.1-8b-instant (recommended)
# Get one at: https://console.groq.com
GROQ_API_KEY=gsk_your-groq-key-here

# OpenAI API key — fallback using gpt-4o-mini
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# HuggingFace API token — used for RAG embeddings (sentence-transformers/all-MiniLM-L6-v2)
# Optional but strongly recommended; without it the HF API is rate-limited and
# the embed script may fail with 429 errors on larger portfolios.
# Get one at: https://huggingface.co/settings/tokens
HF_API_KEY=hf_your-hf-token-here

# ── GitHub content agent ─────────────────────────────────────────────────────
# Autonomously updates your `projects` content in Supabase when you push to
# GitHub. Reuses GROQ_API_KEY above — no separate key needed. Can be toggled
# on/off from the admin dashboard (Settings → AI Agent) without a redeploy.
# See app/api/webhooks/github/route.ts and lib/agent-session.ts.

# Groq model used for the agent's tool-calling loop. Must support function
# calling; llama-3.3-70b-versatile is a solid default. Optional.
AGENT_GROQ_MODEL=llama-3.3-70b-versatile

# Shared secret configured on the GitHub webhook (repo/org Settings → Webhooks).
# Used to verify the X-Hub-Signature-256 header on every delivery.
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here

# Fine-grained GitHub PAT with Contents:Read on the repos you wire up.
# Used to fetch README.md/package.json so the agent has real context.
# Optional, but without it you'll hit unauthenticated GitHub API rate limits.
GITHUB_TOKEN=github_pat_your-token-here

# Comma-separated allow-list of repos permitted to trigger the agent, e.g.
# "jabluetooth/my-project,jabluetooth/other-project". Pushes from any repo
# not in this list are ignored.
GITHUB_ALLOWED_REPOS=

# ── Email ─────────────────────────────────────────────────────────────────────
# Resend API key — used by /api/send to deliver contact-form emails
# Get one at: https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-key-here

# ── Admin Access ──────────────────────────────────────────────────────────────
# The email address that is allowed to access /admin routes.
# MUST match the email you use to sign in via Google OAuth.
# If this is missing, admin access is DENIED to everyone (fail-closed).
MY_EMAIL=your-admin-email@example.com

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Required for admin Google sign-in via Supabase Auth.
# Set up in: Google Cloud Console → APIs & Services → Credentials
# Then add to: Supabase dashboard → Authentication → Providers → Google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# ── App URL ───────────────────────────────────────────────────────────────────
# Your production URL. Used for:
#   - Origin validation on the contact-form API (required in production)
#   - Open Graph metadata / sitemap generation
# In development this can be omitted (defaults to localhost).
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# ── Setup checklist ───────────────────────────────────────────────────────────
# 1. Create a Supabase project and enable the pgvector extension.
# 2. Run the database migrations (SQL files in /supabase/migrations/).
# 3. Enable Anonymous sign-in in Supabase Auth settings.
# 4. Enable Google OAuth in Supabase Auth → Providers.
# 5. Fill in the values above, then: cp .env.example .env.local
# 6. npm install && npm run dev
# 7. Seed your content via the /admin dashboard.
# 8. Run npm run embed  (generates vector embeddings for RAG — re-run after content changes).
#    WARNING: embed wipes and re-indexes ALL embeddings on every run.
#    It requires SUPABASE_SERVICE_ROLE_KEY and optionally HF_API_KEY.
